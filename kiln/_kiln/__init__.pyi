from typing import Sequence, overload

import numpy as np

class DType:
    F32: int
    F16: int
    BF16: int
    Q8_0: int

class Device:
    CPU: int
    CUDA: int

class Graph:
    def __init__(self) -> None: ...
    def size(self) -> int: ...
    def __len__(self) -> int: ...
    def __enter__(self) -> "Graph": ...
    def __exit__(self, *args: object) -> None: ...

float32: DType
f16: DType
bf16: DType
q8_0: DType

class Tensor:
    def __init__(
        self,
        shape: Sequence[int],
        dtype: DType = ...,
        device: Device = ...,
    ) -> None: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def strides(self) -> list[int]: ...
    @property
    def dtype(self) -> DType: ...
    @property
    def device(self) -> Device: ...
    def numel(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def itemsize(self) -> int: ...
    @property
    def has_storage(self) -> bool: ...
    @property
    def is_borrowed(self) -> bool: ...
    @property
    def is_readonly(self) -> bool: ...
    def is_contiguous(self) -> bool: ...
    def data(self) -> bytes: ...
    def numpy(self) -> "np.ndarray": ...
    def reshape(self, dims: Sequence[int]) -> "Tensor": ...
    def view(self, dims: Sequence[int]) -> "Tensor": ...
    def transpose(self, dim0: int, dim1: int) -> "Tensor": ...
    @property
    def T(self) -> "Tensor": ...
    @property
    def mT(self) -> "Tensor": ...
    def contiguous(self) -> "Tensor": ...
    def copy_(self, src: "Tensor") -> "Tensor": ...
    def __add__(self, other: "Tensor") -> "Tensor": ...
    def __mul__(self, other: "Tensor") -> "Tensor": ...
    def __matmul__(self, other: "Tensor") -> "Tensor": ...

def empty(
    shape: Sequence[int],
    dtype: DType = ...,
    device: Device = ...,
) -> Tensor: ...
def zeros(
    shape: Sequence[int],
    dtype: DType = ...,
    device: Device = ...,
) -> Tensor: ...
def ones(
    shape: Sequence[int],
    dtype: DType = ...,
    device: Device = ...,
) -> Tensor: ...
def nbytes(numel: int, dtype: DType) -> int: ...
def itemsize(dtype: DType) -> int: ...
def from_numpy(array: np.ndarray, copy: bool = ...) -> Tensor: ...
def add(a: Tensor, b: Tensor) -> Tensor: ...
def mul(a: Tensor, b: Tensor) -> Tensor: ...
def matmul(a: Tensor, b: Tensor) -> Tensor: ...
def relu(x: Tensor) -> Tensor: ...
def silu(x: Tensor) -> Tensor: ...
def softmax(x: Tensor, axis: int = ...) -> Tensor: ...
def from_buffer(
    buffer: object,
    shape: Sequence[int],
    dtype: DType = ...,
    strides: Sequence[int] | None = ...,
    byte_offset: int = ...,
) -> Tensor: ...
def execute(output: Tensor) -> None: ...
